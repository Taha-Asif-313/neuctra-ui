{
  "name": "@neuctra/ui-mcp",
  "version": "0.4.12",
  "description": "MCP server exposing the @neuctra/ui component registry (props, defaults, examples, theme tokens) so AI coding tools generate accurate Neuctra UI code, plus SEO/AEO/GEO tools (per-page meta, woven JSON-LD, audits).",
  "type": "module",
  "license": "MIT",
  "author": "Your Name <tahaasifaqwe@gmail.com>",
  "homepage": "https://github.com/Taha-Asif-313/neuctra-ui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Taha-Asif-313/neuctra-ui.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "neuctra",
    "ui",
    "react",
    "component-registry",
    "seo",
    "aeo",
    "geo",
    "json-ld"
  ],
  "bin": {
    "neuctra-ui-mcp": "./bin/cli.mjs"
  },
  "main": "./src/server.mjs",
  "exports": {
    ".": "./src/server.mjs",
    "./data/components.json": "./data/components.json",
    "./data/theme.json": "./data/theme.json",
    "./data/design-rules.json": "./data/design-rules.json",
    "./data/component-rules.json": "./data/component-rules.json",
    "./data/seo-guide.json": "./data/seo-guide.json",
    "./data/layouts.json": "./data/layouts.json",
    "./data/variants.json": "./data/variants.json",
    "./data/landing-design.json": "./data/landing-design.json",
    "./data/landing-patterns.json": "./data/landing-patterns.json",
    "./utils/component-search": "./src/utils/component-search.mjs",
    "./utils/search-taxonomy": "./src/utils/search-taxonomy.mjs",
    "./utils/ui-policy": "./src/utils/ui-policy.mjs",
    "./utils/code-skeleton": "./src/utils/code-skeleton.mjs",
    "./utils/code-validation": "./src/utils/code-validation.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "data"
  ],
  "scripts": {
    "sync-registry": "node scripts/sync-registry.mjs",
    "merge-local-components": "node scripts/merge-local-components.mjs",
    "enrich-search-data": "node scripts/enrich-search-data.mjs",
    "sync-landing-patterns": "node scripts/sync-landing-patterns.mjs",
    "start": "node bin/cli.mjs",
    "prepublishOnly": "npm run merge-local-components && npm run sync-landing-patterns"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  }
}
